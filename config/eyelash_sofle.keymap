#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include "keys_fr_belgian_period_mac.h"
#include "keys_fr_belgian_period_linux.h"
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

#define MAC1 0
#define MAC2 1
#define MISC 2
#define CONFIG 3
#define LINUX1 4
#define LINUX2 5

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    // don't know whyt it's here
    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    // add conditional layers to switch mac to windows/linux
    conditional_layers {
        compatible = "zmk,conditional-layers";

        config_layer_1 {
            if-layers = <MAC2 MISC>;
            then-layer = <CONFIG>;
        };

        config_layer_2 {
            if-layers = <LINUX2 MISC>;
            then-layer = <CONFIG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------------------------------------------------------
        // |   @   |  1  |  2  |  3   |  4   |  5   |   *   |  6   |  7    |  8    |  9   |   0   |  BACKSPACE |
        // |  ESC  |  A  |  Z  |  E   |  R   |  T   |   *   |  Y   |  U    |  I    |  O   |   P   |   DELETE   |
        // |  TAB  |  Q  |  S  |  D   |  F   |  G   |   *   |  H   |  J    |  K    |  L   |   M   |     -      |
        // | SHIFT |  W  |  X  |  C   |  V   |  B   |   *   |  N   |  ,    |  ,    |  .   |   /   |   ENTER    |

        mac1 {
            bindings = <
            &kp ESC     &kp N1     &kp N2        &kp N3        &kp N4     &kp N5       &kp UP_ARROW     &kp N6     &kp N7         &kp N8            &kp N9           &kp N0      &kp BACKSPACE
            &kp TAB     &kp FR_A   &kp FR_Z      &kp FR_E      &kp FR_R   &kp FR_T     &kp DOWN_ARROW   &kp FR_Y   &kp FR_U       &kp FR_I          &kp FR_O         &kp FR_P    &kp BSLH
            &kp LCTRL   &kp FR_Q   &kp  FR_S     &kp FR_D      &kp FR_F   &kp FR_G     &kp LEFT_ARROW   &kp FR_H   &kp FR_J       &kp FR_K          &kp FR_L         &kp FR_M    &kp FR_MINUS
            &kp LSHFT   &kp FR_W   &kp FR_X      &kp FR_C      &kp FR_V   &kp FR_B     &kp RIGHT_ARROW  &kp FR_N   &kp FR_COMMA   &kp FR_SEMICOLON  &kp DOT          &kp FSLH    &kp ENTER
            &kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo MAC2   &kp SPACE    &kp ENTER        &kp SPACE  &kp ENTER      &mo MISC          &kp RIGHT_SHIFT  &kp DELETE
            >;
            
            display-name = "Mac1";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        mac2 {
            bindings = <
            &kp FR_AT   &kp F1    &kp F2     &kp F3        &kp F4         &kp F5        &mmv MOVE_UP     &kp F6          &kp F7       &kp F8       &kp F9            &kp F10       &kp F11
            &trans      &trans    &trans     &kp FR_ACUTE  &kp FR_CARET   &kp FR_GRAVE  &mmv MOVE_DOWN   &kp FR_PERCENT  &kp FR_LBKT  &kp FR_RBKT  &kp FR_PLUS       &kp FR_MINUS  &kp F12
            &trans      &trans    &trans     &kp FR_LT     &kp FR_UMLAUT  &kp FR_GT     &mmv MOVE_LEFT   &kp FR_DOLLAR   &kp FR_LPAR  &kp FR_RPAR  &kp FR_AMPERSAND  &kp FR_PIPE   &kp FR_BSLH
            &trans      &trans    &kp K_CUT  &kp K_COPY    &kp K_PASTE    &trans        &mmv MOVE_RIGHT  &kp FR_UNDER    &kp FR_LBRC  &kp FR_RBRC  &kp FR_ASTRK      &kp FR_SLASH  &kp FR_TILDE
            &kp C_MUTE  &trans    &trans     &trans        &trans         &trans        &mkp LCLK        &trans          &trans       &trans       &trans            &trans
            >;
            
            display-name = "Mac2";
            sensor-bindings = <&scroll_encoder>;
        };

        misc {
            display-name = "Misc/Nav";
            bindings = <
            &trans      &trans        &trans          &trans          &trans         &trans       &mmv MOVE_UP     &trans         &trans      &trans      &trans     &trans      &trans
            &trans      &trans        &mkp LCLK       &mkp MCLK       &mkp RCLK      &mkp MB4     &mmv MOVE_DOWN   &kp PG_UP      &kp END     &kp UP      &kp HOME   &trans      &trans
            &trans      &kp INSERT    &trans          &trans          &trans         &mkp MB5     &mmv MOVE_LEFT   &kp PG_DN      &kp LEFT    &kp DOWN    &kp RIGHT  &trans      &trans
            &trans      &trans        &trans          &trans          &trans         &trans       &mmv MOVE_RIGHT  &trans         &trans      &kp INSERT  &trans     &trans      &trans
            &kp C_MUTE  &trans        &trans          &trans          &trans         &trans       &mkp LCLK        &trans         &trans      &trans      &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        config_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans  &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans  &trans        &trans          &trans        &to MAC1      &to LINUX1      &mkp LCLK        &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "Config";
            sensor-bindings = <&scroll_encoder>;
        };
 
        linux1 {
            bindings = <
            &kp ESC     &kp N1      &kp N2         &kp N3         &kp N4      &kp N5        &kp UP_ARROW     &kp N6      &kp N7          &kp N8             &kp N9            &kp N0       &kp BACKSPACE
            &kp TAB     &kp FRX_A   &kp FRX_Z      &kp FRX_E      &kp FRX_R   &kp FRX_T     &kp DOWN_ARROW   &kp FRX_Y   &kp FRX_U       &kp FRX_I          &kp FRX_O         &kp FRX_P    &kp BSLH
            &kp LCTRL   &kp FRX_Q   &kp  FRX_S     &kp FRX_D      &kp FRX_F   &kp FRX_G     &kp LEFT_ARROW   &kp FRX_H   &kp FRX_J       &kp FRX_K          &kp FRX_L         &kp FRX_M    &kp FRX_MINUS
            &kp LSHFT   &kp FRX_W   &kp FRX_X      &kp FRX_C      &kp FRX_V   &kp FRX_B     &kp RIGHT_ARROW  &kp FRX_N   &kp FRX_COMMA   &kp FRX_SEMICOLON  &kp DOT           &kp FSLH     &kp ENTER
            &kp C_MUTE  &kp LCTRL   &kp LEFT_GUI   &kp LEFT_ALT   &mo LINUX2  &kp SPACE     &kp ENTER        &kp SPACE   &kp ENTER       &mo MISC           &kp RIGHT_SHIFT   &kp DELETE
            >;
            
            display-name = "Linux1";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        linux2 {
            bindings = <
            &kp FRX_AT   &kp F1    &kp F2    &kp F3         &kp F4         &kp F5         &mmv MOVE_UP     &kp F6           &kp F7        &kp F8        &kp F9             &kp F10        &kp F11
            &trans      &trans    &trans     &kp FRX_ACUTE  &kp FRX_CARET  &kp FRX_GRAVE  &mmv MOVE_DOWN   &kp FRX_PERCENT  &kp FRX_LBKT  &kp FRX_RBKT  &kp FRX_PLUS       &kp FRX_MINUS  &kp F12
            &trans      &trans    &trans     &kp FRX_LT     &kp FRX_UMLAUT &kp FRX_GT     &mmv MOVE_LEFT   &kp FRX_DOLLAR   &kp FRX_LPAR  &kp FRX_RPAR  &kp FRX_AMPERSAND  &kp FRX_PIPE   &kp FRX_BSLH
            &trans      &trans    &kp K_CUT  &kp K_COPY     &kp K_PASTE    &trans         &mmv MOVE_RIGHT  &kp FRX_UNDER    &kp FRX_LBRC  &kp FRX_RBRC  &kp FRX_ASTRK      &kp FRX_SLASH  &kp FRX_TILDE
            &kp C_MUTE  &trans    &trans     &trans         &trans         &trans         &mkp LCLK        &trans           &trans        &trans        &trans             &trans
            >;
            
            display-name = "Linux2";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
